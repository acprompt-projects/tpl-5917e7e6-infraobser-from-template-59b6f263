{
  "uid": "use-metrics-overview",
  "title": "USE Metrics — Infrastructure Resources",
  "tags": ["use", "infrastructure"],
  "timezone": "utc",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(node_cpu_seconds_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "CPU Utilization (%)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]
        }}
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=~\"$instance\",mode=\"idle\"}[5m])) by (instance)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2, "title": "Memory Utilization (%)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.75 },
            { "color": "red", "value": 0.9 }
          ]
        }}
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3, "title": "Disk I/O Saturation (in-flight)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "id": 4, "title": "Network Saturation (rx/tx drops)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "rate(node_network_receive_drop_total{instance=~\"$instance\"}[5m])", "legendFormat": "rx-drop {{instance}} {{device}}" },
        { "expr": "rate(node_network_transmit_drop_total{instance=~\"$instance\"}[5m])", "legendFormat": "tx-drop {{instance}} {{device}}" }
      ]
    },
    {
      "id": 5, "title": "Node Errors (OOM + Context Switch)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "rate(node_vmstat_oom_kill{instance=~\"$instance\"}[5m])", "legendFormat": "OOM {{instance}}" },
        { "expr": "rate(node_context_switches_total{instance=~\"$instance\"}[5m])", "legendFormat": "ctx-sw {{instance}}" }
      ]
    }
  ]
}